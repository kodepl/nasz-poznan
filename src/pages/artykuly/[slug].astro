---
import Masthead from "../../layouts/Masthead.astro";
import site, { coverFor } from "../../site.config";
import { getCollection } from "astro:content";
import GithubSlugger from "github-slugger";
export async function getStaticPaths() {
  const posts = await getCollection("artykuly");
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
const slugger = new GithubSlugger();
const headings = (post.body.match(/^##\s+(.+)$/gm) || []).map((line) => {
  const text = line.replace(/^##\s+/, "");
  return { text, id: slugger.slug(text) };
});
const minutes = Math.max(1, Math.round(post.body.split(/\s+/).filter(Boolean).length / 200));
const author = post.data.author ?? site.author;
const bio = post.data.authorBio ?? site.authorBio;
const cover = coverFor(post.data.category, post.data.image);
const related = (await getCollection("artykuly")).filter((p) => p.slug !== post.slug && p.data.category === post.data.category).slice(0, 3);
---
<Masthead title={post.data.title} description={post.data.description} image={cover}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-river">{post.data.kicker || post.data.category}</p>
    <h1 class="mt-3 font-display text-4xl font-bold leading-tight md:text-5xl">{post.data.title}</h1>
    <p class="mt-3 text-sm text-ink/60">{author} · {minutes} min czytania · {post.data.pubDate.toLocaleDateString("pl-PL")}</p>
    <img src={cover} alt="" class="mt-8 aspect-[16/9] w-full object-cover" />
    {headings.length > 0 && (
      <nav class="mt-8 border border-ink/20 bg-white/50 p-4 text-sm">
        <p class="font-semibold uppercase tracking-wide">W tekście</p>
        <ol class="mt-2 list-decimal space-y-1 pl-5">
          {headings.map((h) => <li><a href={`#${h.id}`} class="text-river hover:underline">{h.text}</a></li>)}
        </ol>
      </nav>
    )}
    <div class="prose prose-lg prose-slate mt-10 max-w-none prose-headings:font-display prose-a:text-river">
      <Content />
    </div>
    <section class="mt-12 flex gap-4 border-t-2 border-ink pt-6">
      <img src={site.authorAvatar} alt={author} class="h-16 w-16 object-cover" />
      <div>
        <p class="font-display text-xl">{author}</p>
        <p class="text-sm text-ink/70">{bio}</p>
      </div>
    </section>
    {related.length > 0 && (
      <div class="mt-10">
        <p class="text-xs uppercase tracking-widest text-brass">Z tej samej szuflady</p>
        <ul class="mt-3 space-y-2">
          {related.map((item) => (
            <li><a href={`/artykuly/${item.slug}/`} class="font-display text-xl text-river hover:underline">{item.data.title}</a></li>
          ))}
        </ul>
      </div>
    )}
  </article>
</Masthead>
