---
import Masthead from "../layouts/Masthead.astro";
import site from "../site.config";
---
<Masthead title="Kontakt" description={`Napisz do ${site.name}.`}>
  <section class="mx-auto max-w-xl px-4 py-12">
    <h1 class="font-display text-4xl font-bold">Kontakt</h1>
    <p class="mt-4">{site.address}</p>
    <p class="mt-1"><a class="text-river underline" href={`mailto:${site.email}`}>{site.email}</a></p>
    <p class="mt-4 text-sm text-ink/70">Przyjmujemy tipy o mieście, zaproszenia na wydarzenia i sprostowania. Odpowiedź zwykle w 48 h.</p>
    <form class="mt-8 space-y-3" action={"mailto:" + site.email} method="get" enctype="text/plain">
      <input name="subject" required placeholder="Temat" class="w-full border-2 border-ink bg-paper px-3 py-2" />
      <textarea name="body" required rows="5" placeholder="Wiadomość" class="w-full border-2 border-ink bg-paper px-3 py-2"></textarea>
      <button class="bg-ink px-5 py-2 text-sm uppercase tracking-wide text-paper">Wyślij</button>
    </form>
  </section>
</Masthead>
