---
import Masthead from "../layouts/Masthead.astro";
import { getCollection } from "astro:content";
import site, { coverFor, sectionSlug } from "../site.config";
const posts = (await getCollection("artykuly")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lead = posts[0];
const side = posts.slice(1, 4);
const rest = posts.slice(4);
---
<Masthead title={site.name} description={site.tagline} image={site.heroImage}>
  <main class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-8 lg:grid-cols-12">
      {lead && (
        <article class="lg:col-span-8">
          <img src={coverFor(lead.data.category, lead.data.image)} alt="" class="aspect-[16/9] w-full object-cover" />
          <p class="mt-4 text-xs font-semibold uppercase tracking-[0.2em] text-river">{lead.data.kicker || lead.data.category}</p>
          <h2 class="mt-2 font-display text-4xl font-bold leading-tight md:text-5xl">
            <a href={`/artykuly/${lead.slug}/`} class="hover:text-river">{lead.data.title}</a>
          </h2>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/80">{lead.data.description}</p>
        </article>
      )}
      <aside class="space-y-6 border-t border-ink/20 pt-6 lg:col-span-4 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass">W skrócie</p>
        {side.map((post) => (
          <article class="border-b border-ink/10 pb-4">
            <p class="text-[11px] uppercase tracking-wider text-river">{post.data.category}</p>
            <h3 class="mt-1 font-display text-xl leading-snug">
              <a href={`/artykuly/${post.slug}/`} class="hover:text-river">{post.data.title}</a>
            </h3>
          </article>
        ))}
      </aside>
    </div>

    <nav class="my-12 flex flex-wrap gap-3 border-y-2 border-ink py-4">
      {site.sections.map((s) => (
        <a href={`/dzielnice/${sectionSlug(s.name)}/`} class="border border-ink px-4 py-1.5 text-xs font-semibold uppercase tracking-wide hover:bg-ink hover:text-paper">{s.name}</a>
      ))}
    </nav>

    <div class="grid gap-8 md:grid-cols-2">
      {rest.map((post) => (
        <article class="flex gap-4 border-b border-ink/10 pb-6">
          <img src={coverFor(post.data.category, post.data.image)} alt="" class="h-24 w-32 shrink-0 object-cover" />
          <div>
            <p class="text-[11px] uppercase tracking-wider text-river">{post.data.category}</p>
            <h3 class="mt-1 font-display text-2xl leading-snug">
              <a href={`/artykuly/${post.slug}/`} class="hover:text-river">{post.data.title}</a>
            </h3>
            <p class="mt-2 line-clamp-2 text-sm text-ink/70">{post.data.description}</p>
          </div>
        </article>
      ))}
    </div>
  </main>
</Masthead>
