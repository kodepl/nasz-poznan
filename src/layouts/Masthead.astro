---
import site, { sectionSlug } from "../site.config";
const { title, description = site.tagline, image = site.heroImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const today = new Date().toLocaleDateString("pl-PL", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>if(location.hostname.indexOf("www.")!==0 && location.hostname.endsWith("naszpoznan.info")){location.replace(location.href.replace("://","://www."));}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="robots" content="index,follow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,700;1,6..72,400&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-paper font-body text-ink antialiased">
    <div class="border-b-4 border-ink bg-ink text-paper">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2 text-xs uppercase tracking-[0.18em] text-brass">
        <span>{today}</span>
        <span>Wydanie miejskie · Poznań</span>
      </div>
      <header class="mx-auto max-w-6xl px-4 pb-5 pt-3 text-center">
        <a href="/" class="font-display text-5xl font-bold tracking-tight text-paper md:text-6xl">{site.name}</a>
        <p class="mx-auto mt-2 max-w-2xl font-display text-base italic text-brass/90">{site.tagline}</p>
        <nav class="mt-5 flex flex-wrap justify-center gap-x-6 gap-y-2 border-t border-brass/40 pt-4 text-sm font-medium uppercase tracking-wide">
          <a href="/" class="hover:text-brass">Wydanie</a>
          <a href="/artykuly/" class="hover:text-brass">Archiwum</a>
          <a href="/dzielnice/" class="hover:text-brass">Dzielnice</a>
          <a href="/redakcja/" class="hover:text-brass">Redakcja</a>
          <a href="/kontakt/" class="hover:text-brass">Kontakt</a>
        </nav>
      </header>
    </div>
    <slot />
    <footer class="mt-16 border-t-4 border-ink bg-ink text-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3">
        <div>
          <p class="font-display text-2xl">{site.name}</p>
          <p class="mt-2 text-sm text-brass">{site.address}</p>
          <p class="mt-1 text-sm"><a href={`mailto:${site.email}`} class="underline">{site.email}</a></p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest text-brass">Działy</p>
          <ul class="mt-3 space-y-1 text-sm">
            {site.sections.map((s) => (
              <li><a href={`/dzielnice/${sectionSlug(s.name)}/`} class="hover:text-brass">{s.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="text-sm text-paper/70">
          <p>Nie jesteśmy agencją newsową. Publikujemy reportaże i felietony o mieście, w którym się mieszka, a nie tylko przejeżdża.</p>
          <p class="mt-4"><a href="/polityka-prywatnosci/" class="underline">Prywatność</a> · <a href="/regulamin/" class="underline">Regulamin</a></p>
          <p class="mt-2">© {new Date().getFullYear()} {site.name}</p>
        </div>
      </div>
    </footer>
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"PLACEHOLDER_ANALYTICS"}'></script>
  </body>
</html>
