---
import Masthead from "../../layouts/Masthead.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const posts = (await getCollection("artykuly")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return paginate(posts, { pageSize: 9 });
}

const { page } = Astro.props;
---
<Masthead title="Archiwum" description="Wszystkie materiały Naszego Poznania.">
  <main class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="font-display text-4xl font-bold">Archiwum</h1>
    <ol class="mt-10 space-y-6">
      {page.data.map((post, i) => (
        <li class="flex gap-4 border-b border-ink/10 pb-4">
          <span class="font-display text-2xl text-brass">{String((page.currentPage - 1) * page.size + i + 1).padStart(2, "0")}</span>
          <div>
            <p class="text-[11px] uppercase tracking-wider text-river">{post.data.category}</p>
            <a href={`/artykuly/${post.slug}/`} class="font-display text-2xl hover:text-river">{post.data.title}</a>
          </div>
        </li>
      ))}
    </ol>
  </main>

  {page.lastPage > 1 && (
    <nav class="mt-12 flex flex-wrap items-center justify-center gap-3 text-sm" aria-label="Paginacja">
      {page.url.prev ? (
        <a href={page.url.prev} class="underline-offset-2 hover:underline">← Nowsze</a>
      ) : (
        <span class="opacity-40">← Nowsze</span>
      )}
      <span class="tabular-nums opacity-70">{page.currentPage} / {page.lastPage}</span>
      {page.url.next ? (
        <a href={page.url.next} class="underline-offset-2 hover:underline">Starsze →</a>
      ) : (
        <span class="opacity-40">Starsze →</span>
      )}
    </nav>
  )}

</Masthead>
